{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "cypher-baltics",
 "account_id": "f9ee5f3ceb5658869b332ed8a0ed0a72",
 "compatibility_date": "2026-10-01",
 "main": "worker.mjs",
 "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true,"html_handling":"auto-trailing-slash","not_found_handling":"404-page"},
 "observability": {"enabled":true,"head_sampling_rate":0.1,"traces":{"enabled":true,"head_sampling_rate":0.1}},
 "workers_dev":true,
 "routes":[
  {"pattern":"cypherbaltics.org","custom_domain":true},
  {"pattern":"www.cypherbaltics.org","custom_domain":true},
  {"pattern":"cypherbaltics.com","custom_domain":true},
  {"pattern":"www.cypherbaltics.com","custom_domain":true}
 ]
}
